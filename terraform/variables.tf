variable "oci_profile" {
  type        = string
  default     = "DEFAULT"
  description = "Existing API-key profile selected by scripts/deploy.py --profile."
}
variable "region" {
  type        = string
  default     = null
  description = "Deployment region; supplied from the selected OCI profile."
}
variable "iam_policy_compartment_id" {
  type        = string
  default     = null
  description = "Tenancy OCID supplied from the selected OCI profile."
}
variable "home_region" {
  type        = string
  default     = null
  description = "Legacy explicit override; normally Terraform discovers the actual home region."
}
variable "telemetry_compartment_id" { type = string }
variable "dashboard_compartment_id" {
  type    = string
  default = null
}
variable "inventory_compartment_ids" {
  type        = list(string)
  description = "Exact event source compartments; also the read-only inventory scope when coverage is enabled."
  validation {
    condition     = length(var.inventory_compartment_ids) > 0 && length(distinct(var.inventory_compartment_ids)) == length(var.inventory_compartment_ids)
    error_message = "Supply nonempty unique event source compartments."
  }
}
variable "scope_id" {
  type    = string
  default = "production-block-volumes"
  validation {
    condition     = can(regex("^[A-Za-z0-9_-]{1,80}$", var.scope_id))
    error_message = "Use 1..80 letters, digits, underscores or hyphens."
  }
}
variable "create_iam_policy" {
  type        = bool
  default     = false
  description = "Create the native Events and Connector service policies in the home region."
}
variable "log_analytics_namespace" {
  type        = string
  default     = null
  description = "Legacy override; normally discovered from the profile tenancy."
}
variable "dashboard_display_name" {
  type    = string
  default = "OCI Block Volume Backup Activity"
}
variable "alarm_destination_topic_ids" {
  type        = list(string)
  default     = []
  nullable    = false
  description = "Optional existing topics. Empty creates a topic; native activity ingestion does not publish collector alarms."
  validation {
    condition     = alltrue([for id in var.alarm_destination_topic_ids : length(trimspace(id)) > 0])
    error_message = "Topic IDs must not be blank."
  }
}
variable "existing_stream_id" {
  type        = string
  default     = null
  description = "Optional dedicated existing stream in the profile region. Reused read-only; no partitions allocated."
  validation {
    condition     = var.existing_stream_id == null ? true : can(regex("^ocid1\\.stream\\.", var.existing_stream_id))
    error_message = "existing_stream_id must be a Streaming stream OCID."
  }
}
variable "stream_retention_hours" {
  type    = number
  default = 168
  validation {
    condition     = var.stream_retention_hours >= 24 && var.stream_retention_hours <= 168 && floor(var.stream_retention_hours) == var.stream_retention_hours
    error_message = "Streaming retention must be an integer from 24 to 168 hours."
  }
}
# Generated by scripts/deploy.py; do not configure these in user tfvars.
variable "dashboard_import_file" {
  type    = string
  default = null
}
variable "native_source_name" {
  type    = string
  default = null
}

# Coverage is a separate optional inventory dashboard. Activity-only defaults stay unchanged.
variable "enable_coverage" {
  type    = bool
  default = false
}
variable "coverage_function_image" {
  type        = string
  default     = null
  description = "Optional existing regional OCIR image override. Omit to create/reuse a repository, build and push on deploy.py --apply."
}
variable "coverage_subnet_ids" {
  type        = list(string)
  default     = []
  description = "Existing Function subnets with OCI API access (service/NAT gateway), DNS and egress."
}
variable "coverage_regions" {
  type        = list(string)
  default     = []
  description = "Inventory regions; empty uses the profile region. Compartments are reused exactly."
  validation {
    condition     = length(distinct(var.coverage_regions)) == length(var.coverage_regions) && alltrue([for region in var.coverage_regions : can(regex("^[a-z][a-z0-9-]+$", region))])
    error_message = "Coverage regions must be unique OCI region identifiers."
  }
}
variable "coverage_schedule" {
  type        = string
  default     = "10 * * * *"
  description = "UTC hourly-or-slower Resource Scheduler cron. Minimum per-schedule interval is one hour."
  validation {
    condition     = can(regex("^([0-5]?[0-9]) [^ ]+ [^ ]+ [^ ]+ [^ ]+$", var.coverage_schedule))
    error_message = "Use five-field cron with a single minute value; no sub-hour schedules."
  }
}
variable "coverage_settings" {
  type = object({
    default_target   = optional(object({ target_hours = number, grace_hours = number, warning_hours = number }), { target_hours = 24, grace_hours = 0, warning_hours = 4 })
    workload_targets = optional(map(object({ target_hours = number, grace_hours = number, warning_hours = number })), {})
    volume_targets   = optional(map(object({ target_hours = number, grace_hours = number, warning_hours = number })), {})
    workload_tag     = optional(string, "workload")
    owner_tag        = optional(string, "owner")
    stale_hours      = optional(number, 2)
  })
  default = {}
}
# Generated by the Python deployer, not user inputs.
variable "coverage_dashboard_file" {
  type    = string
  default = null
}
variable "coverage_source_name" {
  type    = string
  default = null
}

# Python-managed OCIR bootstrap inputs; repository state is separate from this module.
variable "coverage_repository_name" {
  type    = string
  default = "backup-coverage"
  validation {
    condition     = can(regex("^[a-z0-9]+([._/-][a-z0-9]+)*$", var.coverage_repository_name))
    error_message = "Use a lowercase OCIR repository path with nonempty components."
  }
}
variable "coverage_repository_compartment_id" {
  type        = string
  default     = null
  description = "Optional OCIR compartment override. Defaults to the resolved dashboard_compartment_id (which itself defaults to telemetry)."
}
variable "coverage_existing_repository_id" {
  type    = string
  default = null
}
variable "coverage_registry_host" {
  type    = string
  default = null
  validation {
    condition     = var.coverage_registry_host == null ? true : can(regex("^[a-z0-9]+[a-z0-9.-]*[a-z0-9]$", var.coverage_registry_host))
    error_message = "Registry override must be a hostname without scheme or path."
  }
}
variable "coverage_image_tag" {
  type    = string
  default = null
  validation {
    condition     = var.coverage_image_tag == null ? true : can(regex("^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$", var.coverage_image_tag))
    error_message = "Invalid container image tag."
  }
}

# Generated by deploy.py from the verified publication; never set in user tfvars.
variable "coverage_function_image_digest" {
  type        = string
  default     = null
  description = "Verified image SHA supplied separately from the tagged Function image name."
}
