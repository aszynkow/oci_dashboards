// Alternate editable overview of the current combined architecture.
// Branded PNG: scripts/render_architecture.py -> backup-dashboard-architecture.svg.
// backup-activity-design.png is retained as an identical copy of that render.
digraph backup_dashboards {
  graph [rankdir=LR, bgcolor="#FCFBFA", pad="0.3", nodesep="0.35", ranksep="0.55", fontname="Arial", label="OCI Block Volume Backup Dashboards • Activity + optional Coverage", labelloc=t, fontsize=23];
  node [shape=box, style="rounded,filled", fillcolor=white, color="#DFDCD8", fontname="Arial", fontsize=13, margin="0.18,0.12"];
  edge [color="#312D2A", fontname="Arial", fontsize=10];
  source [label="Existing source compartments\nBlock volumes, groups, backups\nBackup policy assignments\nExact same allowlist for both flows", color="#9E9892"];
  subgraph cluster_region {
    label="OCI • deployment profile region"; color="#9E9892"; style=rounded;
    events [label="OCI Events\nBackup / copy completion rules"];
    stream [label="Streaming\nNew or existing stream"];
    connector [label="Connector Hub\nStreaming → Log Analytics"];
    activity_la [label="Log Analytics\nActivity parser / source / log group"];
    activity [label="OCI Console Activity dashboard\nSaved searches • 24h / 7d / 30d", fillcolor="#F2F7F8"];
    scheduler [label="Resource Scheduler\nHourly at minute :10 UTC"];
    function [label="OCI Function\nExisting VCN / Function subnet\nResource principal • read-only inventory\nTargets / grace / freshness"];
    coverage_la [label="Log Analytics\nCoverage parser / source / log group"];
    coverage [label="OCI Console Coverage dashboard\nCounts / percentages / warning details\nCollection health / stale unknowns", fillcolor="#F2F7F8"];
    ocir [label="OCIR\nPrivate source-versioned image\nPinned digest"];
    monitoring [label="Monitoring\nCustom backup_coverage gauges"];
    logging [label="Logging\nFunction invoke diagnostics\n30-day retention"];
    events -> stream -> connector -> activity_la -> activity;
    scheduler -> function -> coverage_la -> coverage;
    ocir -> function [label="image pull"];
    function -> monitoring;
    function -> logging;
  }
  source -> events [label="native end events"];
  function -> source [label="read-only Block Storage APIs"];
  iam [label="Tenancy home region\nScoped IAM policies\nFunction + schedule dynamic groups", fillcolor="#EDF1EB"];
  deploy [label="Local deployment: Python + Terraform\nProfile / tfvars → generated dashboard JSON\nOCIR state → build / push via Docker or Colima\nPlan → Python SDK fields / parser / source setup\nApply infrastructure state → dashboard import\nNo Terraform local-exec", color="#C74634"];
  deploy -> ocir [style=dashed, label="deployment"];
  deploy -> activity_la [style=dashed, label="schema setup"];
  deploy -> coverage_la [style=dashed, label="schema setup"];
  iam -> function [style=dashed, label="scoped authorization"];
}
